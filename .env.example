# =========================================================================
# SENTINEL GRAPH — Variáveis de Ambiente (NUNCA versione chaves reais!)
# =========================================================================

# Porta HTTP da aplicação (Render injeta automaticamente via PORT)
PORT=8080

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
# Se omitida, o sistema opera com o Motor Analítico Forense Determinístico local.
GEMINI_API_KEY=

# Modelo Gemini opcional (padrão: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Chave opcional da API do Portal da Transparência da CGU
# Solicite gratuitamente em: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
TRANSPARENCIA_API_KEY=

# URL opcional da API de Dados Abertos da Câmara (padrão oficial v2)
CAMARA_API_BASE_URL=https://dadosabertos.camara.leg.br/api/v2/
